# popity.ro: root .htaccess for the static site.
# WordPress lives in /blog and keeps its own /blog/.htaccess.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and drop "www."
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://popity.ro%{REQUEST_URI} [L,R=301]

  # Project pages: /projects/<name>/ is rendered by /projects/project.php
  # from the list in /projects/projects.php.
  RewriteRule ^projects/([a-z0-9-]+)$ /projects/$1/ [L,R=301]
  RewriteRule ^projects/([a-z0-9-]+)/$ /projects/project.php?name=$1 [L]

  # Old blog URLs -> /blog/. The blog used /post-name/ permalinks at the root,
  # so anything that isn't a real file or folder here is sent to the blog
  # (e.g. /everesting-o-intreaga-zi-pe-deal/ -> /blog/everesting-o-intreaga-zi-pe-deal/).
  RewriteCond %{REQUEST_URI} !^/blog/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)$ /blog/$1 [L,R=301]

  # Old query-style links (/?p=123, /?s=search) -> /blog/?...
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|tag|s|m|author)= [NC]
  RewriteRule ^$ /blog/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
